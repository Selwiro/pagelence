<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的云备份与换机迁移规则（dataExtractionRules）。

  只列入阅读进度本身：`state.json` 与损坏恢复用的 `.bak`、同步基线/状态、书城源设置。
  一旦写了 <include>，未列出的路径就都不会备份——内容包、完整词表、下载书籍、缓存
  因此天然被排除，无需再写 <exclude>（写了 lint 也会报「不在已包含路径内」）。

  同步口令用 Android Keystore 加密，换机后密钥不存在，备份 SharedPreferences 没有
  意义，因此不列入。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="state.json" />
        <include domain="file" path="state.json.bak" />
        <include domain="file" path="sync-state.json" />
        <include domain="file" path="sync-baseline.json" />
        <include domain="file" path="source-settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="state.json" />
        <include domain="file" path="state.json.bak" />
        <include domain="file" path="sync-state.json" />
        <include domain="file" path="sync-baseline.json" />
        <include domain="file" path="source-settings.json" />
    </device-transfer>
</data-extraction-rules>
