dist/
*.apk
*.aab
*.aar

# ── Kotlin ──────────────────────────────────────────────────────────
.kotlin/

# ── 签名与密钥：任何情况下都不要入库 ────────────────────────────────
*.jks
*.keystore
*.p12
*.pepk
*.bks
keystore.properties
signing.properties
.env
.env.*

# ── 本地调试产物（模拟器截图、日志、临时导入包）────────────────────
.tmp/
*.log

# ── 文档截图：不入默认分支，改由 screenshots 分支 + GitHub Pages 托管 ──
docs/screenshots/

# ── Python 构建脚本 ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

